PORT=8787
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caselawindia
WEB_ORIGIN=https://caselawindia.io
SITE_URL=https://caselawindia.io
ADMIN_USER=replace-with-admin-user-id
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
JWT_SECRET=replace-with-at-least-32-random-characters
UPLOAD_DIR=./storage/uploads
LOG_LEVEL=info
# eCourtsIndia partner API. Keep the live token server-side and out of Git.
ECI_API_KEY=
ECI_API_BASE_URL=https://webapi.ecourtsindia.com
# Comma-separated official RSS/Atom feed URLs. Keep source attribution on every item.
INCOME_TAX_RSS_FEEDS=
